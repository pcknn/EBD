<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_detection_bridge</name>
  <version>0.0.0</version>
  <description>ROS 2 camera and detection bridge for the Prototype_V1 perception pipeline</description>
  <maintainer email="abel.s.dominguez@gmail.com">Abel Dominguez</maintainer>
  <license>Proprietary</license>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>vision_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>camera_info_manager_py</depend>
  <depend>foxglove_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
